# Copie este arquivo para .env e preencha os valores.

# Senha de acesso à aplicação
APP_PASSWORD=

# Chave secreta do Flask (sessões). Gere um valor aleatório.
SECRET_KEY=

# JSON do Service Account do Google (serializado em uma única linha).
# Ex.: {"type":"service_account","project_id":"...","private_key":"...","client_email":"...","token_uri":"...","universe_domain":"..."}
GOOGLE_CREDENTIALS_JSON=

# ID da planilha Google (o trecho entre /d/ e /edit no URL).
GOOGLE_SHEET_ID=

# Nome da aba onde as linhas serão gravadas.
GOOGLE_SHEET_TAB=Assistencias
